{
    "name": "Meridian",
    "description": "Calm, modern theme with a web-app feel, in dark, light or following Windows: neutral or accent-tinted surfaces, hairline borders, one accent color, clearer hierarchy.",
    "version": "1.4.0",
    "author": "Starluck",
    "tags": [
        "Dark",
        "Light",
        "Minimal",
        "Modern"
    ],
    "github": {
        "owner": "Sampong-Starluck",
        "repo_name": "Meridian"
    },
    "Steam-WebKit": "webkit.css",
    "UseDefaultPatches": true,
    "Conditions": {
        "Navigation": {
            "description": "Left rail puts Library, Store, Community and your profile in a sidebar, with the page as a panel beside it. Top tabs puts the same items in a row under the title bar. In both, right-click an item for its menu.",
            "tab": "Layout",
            "default": "Left rail",
            "values": {
                "Left rail": {
                    "TargetCss": {
                        "affects": [
                            "^Steam$"
                        ],
                        "src": "layouts/rail.css"
                    }
                },
                "Top tabs": {
                    "TargetCss": {
                        "affects": [
                            "^Steam$"
                        ],
                        "src": "layouts/tabs.css"
                    }
                }
            }
        },
        "Library sidebar": {
            "description": "Where the Library's game list goes. Side panel keeps it as its own column inside the page. Blended puts it on the same dark ground as the navigation, with no line between them. In the rail moves it into the left sidebar under the navigation items (Left rail only). Top bar puts Home, the view picker and search in a row above the page, and the game list drops down from it.",
            "tab": "Layout",
            "default": "Side panel",
            "values": {
                "Side panel": {},
                "Blended": {
                    "TargetCss": {
                        "affects": [
                            "^Steam$"
                        ],
                        "src": "sidebar/blended.css"
                    }
                },
                "In the rail": {
                    "TargetCss": {
                        "affects": [
                            "^Steam$"
                        ],
                        "src": "sidebar/in-rail.css"
                    }
                },
                "Top bar": {
                    "TargetCss": {
                        "affects": [
                            "^Steam$"
                        ],
                        "src": "sidebar/top-bar.css"
                    }
                }
            }
        },
        "Appearance": {
            "description": "Dark, Light, or Follow system to match Windows (Settings > Personalization > Colors > app mode). Big Picture stays dark.",
            "tab": "Theme",
            "default": "Dark",
            "values": {
                "Dark": {},
                "Light": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "modes/light.css"
                    }
                },
                "Follow system": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "modes/system.css"
                    }
                }
            }
        },
        "Surface tint": {
            "description": "Tints the backgrounds with your accent color, in dark and light mode. None keeps the neutral zinc greys.",
            "tab": "Theme",
            "default": "None",
            "values": {
                "None": {},
                "Subtle": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "tints/subtle.css"
                    }
                },
                "Strong": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "tints/strong.css"
                    }
                }
            }
        },
        "Accent color": {
            "description": "Used for Play buttons, progress bars, focus rings and highlights.",
            "tab": "Theme",
            "default": "Blue",
            "values": {
                "Blue": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "accents/blue.css"
                    }
                },
                "Mint": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "accents/mint.css"
                    }
                },
                "Amber": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "accents/amber.css"
                    }
                },
                "Violet": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "accents/violet.css"
                    }
                }
            }
        }
    }
}